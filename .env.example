# Session signing secret (any long random string). Required in production.
SESSION_SECRET=

# Stripe. Leave blank to run in demo mode (plans and one-offs unlock without payment).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 once you are registered for GST/PST and Stripe Tax is configured.
STRIPE_AUTOMATIC_TAX=

# Public base URL, used for Stripe return links.
APP_URL=http://localhost:3000

# Where accounts and uploads are stored (a persistent disk in hosting).
DATA_DIR=

# Document checks (Claude reads uploaded court documents). Without it, uploads are saved but marked "unchecked".
ANTHROPIC_API_KEY=
# One-touch email + calendar. Register redirect URIs <APP_URL>/api/connect/microsoft/callback and /api/connect/google/callback.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI assistants (Claude, ChatGPT): the MCP connector is served at <APP_URL>/mcp with OAuth sign-in.
# Domain verification token for the OpenAI app directory (served at /.well-known/openai-apps-challenge).
OPENAI_APPS_CHALLENGE=

# Legal pages and support. LEGAL_ENTITY_NAME is the registered company that operates Demand Now.
# SUPPORT_EMAIL is shown on /support, /privacy and /terms, and receives the support form (falls back to SERVICE_OPS_EMAIL).
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=

# Mobile notary/commissioner bookings and local-partner referrals go to this inbox (falls back to SERVICE_OPS_EMAIL).
WITNESS_OPS_EMAIL=
